    "%@ — %@. Shortcut: function key plus %lld." : {
      "comment" : "A button that toggles the state of a feature, such as a shortcut or a setting. The label inside the button describes the feature, and the text following the button's label describes the action that will occur when the button is pressed. In this case, the label \"\\(integration?.name ?? identifier.rawValue) — fn+\\(shortcutNumber)\" describes the feature, and the text \"Shortcut: function key plus \\(shortcutNumber)\" describes the action that will occur when the button is",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$@. Shortcut: function key plus %3$lld."
          }
        }
      }
    },
